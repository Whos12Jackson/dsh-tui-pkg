{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "id": "dsh-tui-pkg",
  "name": "dsh-tui-pkg",
  "version": "0.4.0",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "dsh-tui-pkg.pkg",
      "reason": "在终端里浏览、安装、卸载、启用或停用 profile 的插件与 bundle"
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "dsh-tui-pkg.pkg",
        "title": "pkg",
        "description": "管理插件与 bundle：浏览、安装、卸载、启用、停用"
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/Whos12Jackson/dsh-tui-pkg"
  }
}
