{
  "name": "dsh-tui-pkg",
  "version": "0.4.1",
  "description": "In-terminal plugin manager for dsh-tui: list installed plugins and bundles, and install, remove, enable or disable them without leaving the TUI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tui",
    "deepseek-harness",
    "plugin-manager",
    "cordis",
    "tui"
  ],
  "license": "MIT",
  "author": "Whos12Jackson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whos12Jackson/dsh-tui-pkg.git"
  },
  "homepage": "https://github.com/Whos12Jackson/dsh-tui-pkg#readme",
  "bugs": {
    "url": "https://github.com/Whos12Jackson/dsh-tui-pkg/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-harness-tui/dsh-tui": ">=0.9.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-harness-tui/dsh-tui": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
